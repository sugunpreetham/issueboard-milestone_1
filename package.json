{
  "name": "issue-board",
  "version": "1.1.0",
  "description": "High-performance, accessible issue tracker with zero external UI dependencies, offline mutation sync, cryptographic audit logging, and AST query parsing.",
  "author": "Sugun Preetham Devabarkina <sugunpreetham07@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugunpreetham/issueboard-milestone_1.git"
  },
  "homepage": "https://github.com/sugunpreetham/issueboard-milestone_1#readme",
  "keywords": [
    "react",
    "typescript",
    "issue-tracker",
    "ast-parser",
    "offline-first",
    "state-machine",
    "audit-trail",
    "wcag-aa",
    "zero-dependencies"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run src/tests/benchmarks.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
